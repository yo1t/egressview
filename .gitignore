# 鍵関連（誤って置かれた場合の保険）
*.pem
*.key
id_rsa*
id_ed25519*
# Only reviewed release public keys may be tracked; private key patterns stay ignored.
!release-signing/*.pub.pem
# ASH セキュリティスキャン: 出力はローカル専用だが、設定（suppression 込み）は
# CI ゲートで再現するためにトラッキングする。
# 親ディレクトリごと除外すると negation が効かないため .ash/* で中身を除外する。
.ash/*
!.ash/.ash.yaml
# テストのベースライン（実機データに依存）
test/fixtures/baseline.json
# Playwright 生成物
test-results/
playwright-report/
.egressview.pid
local-media/
redacted-media/
.pages-source/
_site/
dist/

# Playwright test output
test-results/
playwright-report/
# TLS 証明書（自己署名・自動生成）
.egressview-cert.pem
.egressview-key.pem
# conntrack 検証環境（内部用・公開しない）
dev-conntrack/
# DB マイグレーション前自動バックアップ
*.pre-migration.*.bak
# GitHub traffic analysis artifacts (local only)
docs/github-traffic-last-month.svg
scripts/render-traffic-report.js
# Local-only Claude Code guidance (not shared with other contributors)
CLAUDE.local.md

# Local operational runbooks. These carry account ids, key ARNs and profile
# names for one specific environment; the published procedure lives in the
# matching docs/*.md without them.
docs/*.local.md
# AWS CDK infrastructure (P2-63 web public exposure; local deploy tooling, not distributed)
infra/

# MCP audit store (P2-60 PR 4) — local operational data
.egressview-mcp-audit.db
.egressview-mcp-audit.db-shm
.egressview-mcp-audit.db-wal
# MCP publication gate: deployment-specific evidence and sanitized local report
.egressview-mcp-publication-evidence.json
.egressview-mcp-publication-gate.json

# Local Xcode and SwiftPM workspace state
apps/agent-macos/.swiftpm/
apps/agent-macos/EgressViewAgent.xcodeproj/project.xcworkspace/
apps/agent-macos/EgressViewAgent.xcodeproj/xcuserdata/

# Icon build output. design/icons/*.svg are the only hand-edited sources;
# everything under build/ is regenerated by scripts/build-agent-icons.sh.
design/icons/build/
*.iconset/
# Generated by the same script and compiled by Xcode at build time.
apps/agent-macos/Xcode/Host/Assets.xcassets/
