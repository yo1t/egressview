# EgressView MCP Server — environment variables
# Copy to .env.mcp and fill in your values. Do not commit .env.mcp.
#
# Usage:
#   stdio mode (local):  EGRESSVIEW_URL=... EGRESSVIEW_TOKEN=... node mcp-server.js
#   HTTP mode (private): MCP_PORT=3010 MCP_TOKEN=... MCP_SERVICE_TOKEN=... EGRESSVIEW_URL=... node mcp-server.js
#
# Deployment profile. When omitted, stdio -> local-stdio, HTTP token ->
# private-http, and HTTP OAuth -> public-oauth. Set private-oauth explicitly
# for an internal OIDC issuer. See docs/deployment-profiles.md.
# EGRESSVIEW_DEPLOYMENT_PROFILE=local-stdio

# URL of the running EgressView server (no trailing slash)
# Local:  http://localhost:3000
# Remote: http://your-server-ip:3000
EGRESSVIEW_URL=http://localhost:3000

# API/admin token for stdio compatibility and initial service-identity setup.
# HTTP mode uses MCP_SERVICE_TOKEN at runtime instead.
EGRESSVIEW_TOKEN=

# HTTP transport: port for the MCP HTTP server (omit for stdio mode)
# MCP_PORT=3010
# Bind remains loopback by default. A non-loopback IP additionally requires an
# explicit deployment profile and MCP_ALLOW_NON_LOOPBACK=true. Terminate TLS
# before sending credentials over a LAN, VPN, private subnet, or container network.
# MCP_BIND_ADDRESS=127.0.0.1
# MCP_ALLOW_NON_LOOPBACK=false

# HTTP endpoint authentication mode: token (default) or oauth.
# MCP_AUTH_MODE=token

# Private HTTP endpoint token. Required explicitly in token mode.
# It must not be the EGRESSVIEW_TOKEN used for the EgressView admin API.
# MCP_TOKEN=

# All HTTP modes require a scoped API identity with exactly network.read and
# notes.write plus a dedicated audit HMAC key. Neither value may be reused as
# MCP_TOKEN or EGRESSVIEW_TOKEN.
# MCP_SERVICE_TOKEN=egv_<64 hexadecimal characters>
# Stable HMAC key for audit pseudonyms. Generate once with:
#   openssl rand -hex 32
# Keep this value when MCP_SERVICE_TOKEN is rotated.
# MCP_AUDIT_HMAC_KEY=<64 hexadecimal characters>

# OAuth Resource Server mode (staged P2-60 support). Do not expose this endpoint
# to the Internet until the remaining P2-60 publication gates are complete.
# MCP_AUTH_MODE=oauth
# MCP_OAUTH_ISSUER=https://idp.example.com/realms/egressview
# MCP_OAUTH_RESOURCE=https://monitor.example.com/mcp
# MCP_OAUTH_READ_SCOPE=egressview:read
# MCP_OAUTH_NOTES_WRITE_SCOPE=egressview:notes.write
