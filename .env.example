# EgressView environment variables example
#
# Runtime settings are saved to .egressview.json after startup.
# Use this file only for startup defaults or reverse-proxy deployment settings.
# Copy to .env for local use. Do not commit .env.

PORT=3000
# Values below 10000ms are clamped to protect the router and event loop.
POLL_INTERVAL_MS=60000

# Maximum recent connection records retained in memory. Full history remains
# in SQLite and cold records are hydrated when observed again.
# EGRESSVIEW_HISTORY_HOT_MAX=100000

# ASUS router default. You can also set this later from the settings UI.
# ROUTER_IP=192.168.1.1

# Yamaha RTX SSH defaults. You can also set these later from the settings UI.
# YAMAHA_IP=192.168.1.1
# YAMAHA_USER=admin
# YAMAHA_PASS=
# YAMAHA_NAT=100

# Reverse proxy sub-path, for example https://example.com/egressview
# SUBPATH=/egressview
# Canonical HTTPS origin used for OIDC callbacks and Secure cookies.
# EGRESSVIEW_PUBLIC_URL=https://egressview.example.com
# Trust forwarded client/protocol headers only from these exact proxy IPs/CIDRs.
# Never use a broad trust-all proxy setting.
# EGRESSVIEW_TRUST_PROXY=127.0.0.1,10.41.0.0/16
# Force Secure browser cookies when TLS terminates outside the trusted proxy.
# EGRESSVIEW_SECURE_COOKIES=true
# Sliding browser-session lifetime; accepted range is 1 to 365 days.
# EGRESSVIEW_SESSION_TTL_DAYS=30
# Global API limits per client and minute.
# EGRESSVIEW_RATE_LIMIT_READS=600
# EGRESSVIEW_RATE_LIMIT_WRITES=120
# Set to false to disable the 60-second CPU/event-loop runtime profile log.
EGRESSVIEW_RUNTIME_PROFILE=true

# Backup dry-run/prune runs in a worker. The default one-hour limit supports
# multi-gigabyte integrity checks; accepted range is 60,000ms to 6 hours.
# EGRESSVIEW_BACKUP_PRUNE_TIMEOUT_MS=3600000

# AWS SDK retry behavior for Amazon Bedrock. Standard is the AWS-recommended
# default. Use adaptive only for a throttling-heavy, latency-tolerant deployment.
# AWS_RETRY_MODE=standard
# AWS_MAX_ATTEMPTS=3

# ── Offline mode (P2-65 Phase 2) ─────────────────────────────────────────────
# Set to exactly "true" for an air-gapped or egress-filtered deployment. Every
# internet-dependent feature is then disabled *before* startup, so nothing is
# attempted and nothing times out: RDAP, GeoIP, threat feeds, the OUI vendor
# database, manual threat lookup, Google OIDC, and the Anthropic/OpenAI/Bedrock
# providers. Router SSH collection, SQLite, the web UI, and stdio/private HTTP
# MCP keep working.
# EGRESSVIEW_OFFLINE_MODE=true
#
# Features that may be served from inside an isolated network are allowed only
# when you point them at something. Leaving these unset keeps them disabled.
# EGRESSVIEW_INTERNAL_DNS=10.0.0.53
# EGRESSVIEW_OLLAMA_URL=http://10.0.0.20:11434

# Optional absolute or relative directory for verified SQLite generations.
# Useful when backups must live on a separately mounted offline volume.
# EGRESSVIEW_BACKUP_DIR=/var/lib/egressview/backups
