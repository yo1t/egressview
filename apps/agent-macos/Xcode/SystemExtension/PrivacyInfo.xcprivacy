<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This extension observes connection metadata and hands it to the host
	     app through the app group. It does not make the host app's outbound
	     requests. The host app's separate privacy manifest declares data
	     collected through update checks and optional external services.
	     See docs/agent-privacy.md. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Reading and writing the app's own settings, and the settings
			     shared with the system extension through the app group. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
		<dict>
			<!-- File metadata is read only to size files the app itself wrote:
			     the observation journal and store in the app group container,
			     and a downloaded update package in the app's own temporary
			     directory. No file outside those containers is inspected. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- Free space is read for one purpose: before the store rewrites
			     itself to give back the pages deleted history was holding, it
			     checks that the volume can hold the copy that rewrite makes.
			     The moment the file is about to shrink is the moment it needs
			     the most room, and filling the user's disk to save space on
			     it would be a poor trade. The value is used in that decision
			     and nowhere else; it is never recorded and never sent. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
