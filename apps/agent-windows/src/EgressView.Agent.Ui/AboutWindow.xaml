<Window x:Class="EgressView.Agent.Ui.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AboutAgent}" Width="760" Height="680" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="EgressView Agent for Windows" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Text="{DynamicResource AboutSummary}" Style="{StaticResource BodySecondaryStyle}" Margin="0,4,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource UiBuild}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="UiVersion" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="UiBuild" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap" Margin="0,3,12,0"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource ServiceBuild}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ServiceVersion" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ServiceBuild" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="2">
      <TabItem Header="{DynamicResource ProductInfo}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock x:Name="ProductDetails" TextWrapping="Wrap"/><Button Content="{DynamicResource CopyVersion}" Click="CopyVersion_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource License}"><TextBox x:Name="LicenseText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="12"/></TabItem>
      <TabItem Header="{DynamicResource ThirdPartyNotices}"><TextBox x:Name="NoticesText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="12"/></TabItem>
    </TabControl>
    <Button Grid.Row="3" Content="{DynamicResource Close}" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0" MinWidth="96"/>
  </Grid>
</Window>
