<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WPF's built-in Fluent ThemeMode is the supported .NET 10 path, but its API remains marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../EgressView.Agent.Core/EgressView.Agent.Core.csproj" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="render-check" /></ItemGroup>
  <ItemGroup>
    <!-- The same bundled Natural Earth TopoJSON used by the Mac Agent. -->
    <Resource Include="../../../agent-macos/Sources/EgressViewAgentCore/Resources/world-atlas-countries-110m.json"
              Link="Resources/world-atlas-countries-110m.json" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="../../../../LICENSE" Link="Resources/LICENSE.txt" />
    <Resource Include="../../../../THIRD_PARTY_NOTICES.md" Link="Resources/THIRD_PARTY_NOTICES.md" />
  </ItemGroup>
</Project>
