      <TabItem Header="{DynamicResource Threats}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource Threats}" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="ThreatStatus" Text="{DynamicResource ThreatNotChecked}" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/></StackPanel><UniformGrid Grid.Row="2" Columns="3"><Border Style="{StaticResource MetricCardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="{DynamicResource CheckedDestinations}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ThreatChecked" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="6,0"><StackPanel><TextBlock Text="{DynamicResource HighConfidence}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ThreatHigh" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="{DynamicResource LowConfidence}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ThreatLow" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border></UniformGrid><Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0"><DataGrid x:Name="ThreatGrid" ItemsSource="{Binding ThreatRows}" IsReadOnly="True" AutoGenerateColumns="False" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource SurfaceSecondaryBrush}" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Confidence}" Binding="{Binding Confidence}" Width="110"/><DataGridTextColumn Header="{DynamicResource Destination}" Binding="{Binding Destination}" Width="*"/><DataGridTextColumn Header