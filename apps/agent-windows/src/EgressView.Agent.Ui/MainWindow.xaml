<Window x:Class="EgressView.Agent.Ui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EgressView Agent for Windows" Height="560" Width="760" MinHeight="460" MinWidth="620">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="EgressView Agent for Windows" FontSize="24" FontWeight="SemiBold" />
    <TabControl Grid.Row="1" Margin="0,20,0,0">
      <TabItem Header="状態 / Status">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="状態を更新 / Refresh" Click="Refresh_Click" Padding="14,8" AutomationProperties.Name="状態を更新"/>
            <Button Content="7日 / 7 days" Click="SevenDays_Click" Margin="8,0,0,0" Padding="14,8"/>
            <Button Content="30日 / 30 days" Click="ThirtyDays_Click" Margin="8,0,0,0" Padding="14,8"/>
          </StackPanel>
          <Border Grid.Row="1" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Background="#F6F8FA" Padding="18">
            <TextBox x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontFamily="Segoe UI" FontSize="16" AutomationProperties.Name="Agent status and history" />
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Hub登録 / Hub enrollment">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="EgressView Hubへ登録 / Enroll with EgressView Hub" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Margin="0,10,0,18" TextWrapping="Wrap" Text="登録申請では、このPCのホスト名、Windowsのバージョン、Agentのバージョンを指定したHubへ送ります。登録後も、下のスイッチを明示的にONにするまで観測データは送信しません。&#x0a;&#x0a;Enrollment sends this PC's hostname, Windows version, and Agent version to the Hub you specify. Observations are not delivered until you explicitly turn on the switch below."/>
            <TextBlock Text="Hub URL" FontWeight="SemiBold"/>
            <TextBox x:Name="HubUrl" Margin="0,6,0,14" Padding="8" Text="https://" AutomationProperties.Name="Hub URL"/>
            <TextBlock Text="6文字の登録コード / Six-character enrollment code" FontWeight="SemiBold"/>
            <PasswordBox x:Name="EnrollmentCode" Margin="0,6,0,14" Padding="8" MaxLength="6" AutomationProperties.Name="Enrollment code"/>
            <Button x:Name="EnrollButton" Content="登録を申請 / Request enrollment" Click="Enroll_Click" Padding="14,9" HorizontalAlignment="Left"/>
            <CheckBox x:Name="DeliveryEnabled" Margin="0,18,0,0" Content="観測データをこのHubへ送信する / Send observations to this Hub" Click="DeliveryEnabled_Click" AutomationProperties.Name="Hub observation delivery"/>
            <Border Margin="0,18,0,0" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Background="#F6F8FA" Padding="14">
              <TextBlock x:Name="EnrollmentStatus" Text="未登録 / Not enrolled" TextWrapping="Wrap" AutomationProperties.Name="Enrollment status"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
