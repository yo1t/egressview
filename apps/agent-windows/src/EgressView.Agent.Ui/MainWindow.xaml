      <TabItem Header="{DynamicResource NotificationHistory}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource NotificationHistory}" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="NotificationSummary" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource SendTest}" Click="SendTestNotification_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="{DynamicResource ClearHistory}" Click="ClearNotifications_Click" Style="{StaticResource FluentButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid><Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0"><ListView x:Name="NotificationList" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DateText}"/><TextBlock Grid.Column="1" Text="{Binding Kind}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid></TabItem>
