        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><Grid MinHeight="650"><Grid.RowDefinitions><RowDefinition Height="1.05*"/><RowDefinition Height="14"/><RowDefinition Height="0.95*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="0.36*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.64*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource CommunicationDestinations}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource MarkerMetric}" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><ListBox x:Name="GlobeViewChoice" Grid.Column="1" Width="240" SelectedIndex="0" SelectionChanged="GlobeViewChoice_SelectionChanged" Style="{StaticResource SegmentedSelectorStyle}"><ListBoxItem Tag="globe" Content="{DynamicResource Globe}"/><ListBoxItem Tag="countries" Content="{DynamicResource DestinationCountries}"/></ListBox></Grid><Grid Grid.Row="1" Margin="0,8,0,0"><local:WorldGlobeControl x:Name="Globe" MinHeight="230"/><ListView x:Name="CountryList" Visibility="Collapsed" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="GlobeCaption" Text="{DynamicResource GlobeUnavailable}" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/><Button x:Name="RotateButton" Grid.Column="1" Content="{DynamicResource Rotate}" Click="Rotate_Click" Style="{StaticResource FluentButtonStyle}" Margin="12,0,0,0"/></Grid></Grid></Border>
          <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource PeriodGlance}" FontSize="16" FontWeight="SemiBold"/><Grid Margin="0,9,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Fill, ElementName=MonitoringDot}" Margin="0,0,7,0"/><TextBlock Text="{Binding Text, ElementName=MonitoringStatus}" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="StorageSummary" Style="{StaticResource BodySecondaryStyle}" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="MonitoringSince" Grid.Column="1" Style="{StaticResource BodySecondaryStyle}" VerticalAlignment="Center"/></Grid><UniformGrid Columns="5"><Border Style="{StaticResource MetricCardStyle}" Margin="0,0,5,0"><StackPanel><TextBlock Text="{DynamicResource Connections}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ConnectionCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource Applications}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ApplicationCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource Destinations}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="DestinationCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource Coverage}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="CoverageValue" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0,0,0"><StackPanel><TextBlock Text="{DynamicResource Threats}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ThreatCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border></UniformGrid><TextBlock x:Name="CoverageNote" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{DynamicResource PacketPrivacy}" Style="{StaticResource BodySecondaryStyle}" Margin="0,8,0,0"/></StackPanel></Border>
          <Grid Grid.Row="2" Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource WhichAppWhere}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="FlowCaption" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><local:NetworkFlowControl x:Name="FlowDiagram" Grid.Row="1" Margin="0,12,0,0" MinHeight="170"/></Grid></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource WhenTraffic}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="TimelineCaption" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><local:TrafficTimelineControl x:Name="Timeline" Grid.Row="1" Margin="0,12,0,0" MinHeight="170"/></Grid></Border></Grid>
        </Grid></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="{DynamicResource Insights}"><ScrollViewer><StackPanel><TextBlock Text="{DynamicResource LocalInsights}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource InsightsPrivacy}" Style="{StaticResource BodySecondaryStyle}" Margin="0,4,0,16"/><UniformGrid Columns="4"><Border Style="{StaticResource MetricCardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="{DynamicResource Connections}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="InsightConnections" Text="—" Style="{StaticResource MetricValueStyle}"/><TextBlock x:Name="InsightConnectionsDelta" Style="{StaticResource BodySecondaryStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="6,0"><StackPanel><TextBlock Text="{DynamicResource Applications}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="InsightApplications" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="6,0"><StackPanel><TextBlock Text="{DynamicResource Destinations}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="InsightDestinations" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="{DynamicResource DataVolume}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="InsightBytes" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border></UniformGrid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource TopApplications}" FontSize="17" FontWeight="SemiBold"/><ListView x:Name="TopApplicationsList" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" DisplayMemberPath="Display"/></StackPanel></Border><Border Grid.Column="2" Style="