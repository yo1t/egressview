<Window x:Class="EgressView.Agent.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EgressView.Agent.Ui" Title="EgressView Agent for Windows" Height="820" Width="1180" MinHeight="680" MinWidth="940" WindowStartupLocation="CenterScreen">
  <Grid Background="{DynamicResource AppBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1"><Grid Margin="32,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="10" Background="#0B1424" VerticalAlignment="Center" Margin="0,0,14,0"><Viewbox Margin="7"><Canvas Width="32" Height="32"><Rectangle Canvas.Left="4" Canvas.Top="4" Width="5" Height="24" RadiusX="1.5" Fill="#4D94FF"/><Rectangle Canvas.Left="4" Canvas.Top="4" Width="15" Height="5" RadiusX="1.5" Fill="#4D94FF"/><Rectangle Canvas.Left="4" Canvas.Top="13.5" Width="10" Height="5" RadiusX="1.5" Fill="#4D94FF"/><Rectangle Canvas.Left="4" Canvas.Top="23" Width="15" Height="5" RadiusX="1.5" Fill="#4D94FF"/><Ellipse Canvas.Left="23" Canvas.Top="4" Width="6" Height="6" Fill="#24D6A2"/><Ellipse Canvas.Left="24" Canvas.Top="14" Width="4" Height="4" Fill="#4D94FF"/><Ellipse Canvas.Left="24" Canvas.Top="24" Width="4" Height="4" Fill="#4D94FF"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="EgressView Agent" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{DynamicResource AppSubtitle}" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="MonitoringBadge" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="14" Padding="12,6" Margin="0,0,16,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="MonitoringDot" Width="8" Height="8" Margin="0,0,7,0"/><TextBlock x:Name="MonitoringStatus" Text="{DynamicResource Checking}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border><Button x:Name="SevenDaysButton" Content="{DynamicResource Last7Days}" Click="SevenDays_Click" Style="{StaticResource SelectedPeriodButtonStyle}"/><Button x:Name="ThirtyDaysButton" Content="{DynamicResource Last30Days}" Click="ThirtyDays_Click" Style="{StaticResource PeriodButtonStyle}" Margin="8,0,0,0"/><Button Content="↻" ToolTip="{DynamicResource Refresh}" Click="Refresh_Click" Style="{StaticResource FluentButtonStyle}" FontSize="19" Padding="12,5" Margin="8,0,0,0"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1" Margin="32,18,32,28"><TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
      <TabItem Header="{DynamicResource NetworkStatus}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="620"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource NetworkStatus}" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="PeriodCaption" Text="{DynamicResource Last7Days}" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><Button Grid.Column="1" Content="{DynamicResource ExportCsv}" Click="ExportCsv_Click" Style="{StaticResource FluentButtonStyle}"/></Grid>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="1.05*"/><RowDefinition Height="14"/><RowDefinition Height="0.95*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="0.42*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.58*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Globe}" FontSize="16" FontWeight="SemiBold"/><local:WorldGlobeControl x:Name="Globe" Grid.Row="1" MinHeight="220" AutomationProperties.Name="{DynamicResource Globe}"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="GlobeCaption" Text="{DynamicResource GlobeUnavailable}" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/><Button x:Name="RotateButton" Grid.Column="1" Content="{DynamicResource Stop}" Click="Rotate_Click" Style="{StaticResource FluentButtonStyle}" Margin="12,0,0,0"/></Grid></Grid></Border>
          <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource PeriodGlance}" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,12"><Ellipse Width="8" Height="8" Fill="{Binding Fill, ElementName=MonitoringDot}" Margin="0,0,7,0"/><TextBlock Text="{Binding Text, ElementName=MonitoringStatus}" FontWeight="SemiBold"/></StackPanel><UniformGrid Columns="5"><Border Style="{StaticResource MetricCardStyle}" Margin="0,0,5,0"><StackPanel><TextBlock Text="{DynamicResource Connections}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ConnectionCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource Applications}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ApplicationCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource Destinations}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="DestinationCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource Coverage}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="CoverageValue" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0,0,0"><StackPanel><TextBlock Text="{DynamicResource Threats}" Style="{StaticResource MetricLabelStyle}"/><TextBlock Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border></UniformGrid><TextBlock Text="{DynamicResource PacketPrivacy}" Style="{StaticResource BodySecondaryStyle}" Margin="0,12,0,0"/></StackPanel></Border>
          <Grid Grid.Row="2" Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition Width="0.48*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.52*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource WhichAppWhere}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="FlowCaption" Text="{DynamicResource RibbonConnections}" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><local:NetworkFlowControl x:Name="FlowDiagram" Grid.Row="1" Margin="0,14,0,0" MinHeight="110" AutomationProperties.Name="{DynamicResource WhichAppWhere}"/></Grid></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource WhenTraffic}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource TimelineTotal}" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><local:TrafficTimelineControl x:Name="Timeline" Grid.Row="1" Margin="0,14,0,0" MinHeight="110" AutomationProperties.Name="{DynamicResource TrafficTimeline}"/></Grid></Border></Grid>
        </Grid></Grid></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource ConnectionLog}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource ConnectionLog}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource NewestFirstLocal}" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{DynamicResource Rows}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="RowLimit" Width="88" MinHeight="36" SelectedIndex="1" SelectionChanged="RowLimit_SelectionChanged"><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/><ComboBoxItem Content="200"/><ComboBoxItem Content="500"/></ComboBox><Button Content="{DynamicResource ExportCsv}" Click="ExportCsv_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"/></StackPanel></Grid>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0"><DataGrid x:Name="ConnectionGrid" ItemsSource="{Binding RecentFlows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource SurfaceSecondaryBrush}" HorizontalGridLinesBrush="{DynamicResource StrokeBrush}" RowHeight="38" AutomationProperties.Name="{DynamicResource ConnectionLog}"><DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/><Setter Property="Padding" Value="10,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource LastSeen}" Binding="{Binding LastSeenText}" SortMemberPath="LastSeen" Width="160"/><DataGridTextColumn Header="{DynamicResource Process}" Binding="{Binding ProcessName}" Width="*"/><DataGridTextColumn Header="{DynamicResource Destination}" Binding="{Binding Destination}" Width="1.3*"/><DataGridTextColumn Header="{DynamicResource Protocol}" Binding="{Binding Protocol}" Width="90"/><DataGridTextColumn Header="{DynamicResource BytesIn}" Binding="{Binding BytesReceivedText}" Width="100"/><DataGridTextColumn Header="{DynamicResource BytesOut}" Binding="{Binding BytesSentText}" Width="100"/><DataGridTextColumn Header="{DynamicResource Collector}" Binding="{Binding Origin}" Width="90"/></DataGrid.Columns></DataGrid></Border><TextBlock x:Name="LogStatus" Grid.Row="3" Style="{StaticResource BodySecondaryStyle}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/></Grid></TabItem>
      <TabItem Header="{DynamicResource NotificationHistory}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource NotificationHistory}" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="NotificationSummary" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource SendTest}" Click="SendTestNotification_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="{DynamicResource ClearHistory}" Click="ClearNotifications_Click" Style="{StaticResource FluentButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid><Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0"><ListView x:Name="NotificationList" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding Kind}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid></TabItem>
      <TabItem Header="{DynamicResource Settings}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="860" HorizontalAlignment="Center"><TextBlock Text="{DynamicResource Settings}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource SettingsHint}" Style="{StaticResource BodySecondaryStyle}" Margin="0,5,0,20"/><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource HubConnect}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource HubExplanation}" Margin="0,6,0,16" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,18"><StackPanel><TextBlock Text="{DynamicResource ReviewBeforeSending}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{DynamicResource EnrollmentPrivacy}" Margin="0,5,0,0" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/></StackPanel></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hub URL" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="HubUrl" Text="https://" MinHeight="36"/><TextBlock Text="{DynamicResource EnrollmentCode}" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><PasswordBox x:Name="EnrollmentCode" MaxLength="6" MinHeight="36"/><Button x:Name="EnrollButton" Content="{DynamicResource RequestEnrollment}" Click="Enroll_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource HubRegistration}" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="DeliveryEnabled" Content="{DynamicResource DeliveryOption}" Click="DeliveryEnabled_Click"/><Border Margin="0,16,0,0" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="14"><TextBlock x:Name="EnrollmentStatus" Text="{DynamicResource NotEnrolled}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border></StackPanel></Grid></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="{DynamicResource Settings}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="LanguageChoice" Grid.Column="1" MinHeight="36" SelectionChanged="LanguageChoice_SelectionChanged"><ComboBoxItem Tag="System" Content="{DynamicResource SystemDefault}"/><ComboBoxItem Tag="English" Content="English"/><ComboBoxItem Tag="Japanese" Content="日本語"/></ComboBox><TextBlock Grid.Row="2" Text="{DynamicResource NotificationsEnabled}" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="NotificationsEnabled" Grid.Row="2" Grid.Column="1" Checked="NotificationSettings_Changed" Unchecked="NotificationSettings_Changed"/><TextBlock Grid.Row="4" Text="{DynamicResource DailyLimit}" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="DailyLimitChoice" Grid.Row="4" Grid.Column="1" MinHeight="36" SelectionChanged="NotificationSettings_Changed"><ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="20"/></ComboBox><TextBlock Grid.Row="6" Text="{DynamicResource GlobeFrameRate}" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="FrameRateChoice" Grid.Row="6" Grid.Column="1" MinHeight="36" SelectionChanged="FrameRateChoice_SelectionChanged"><ComboBoxItem Tag="3" Content="{DynamicResource EnergySaver}"/><ComboBoxItem Tag="5" Content="{DynamicResource Standard}"/><ComboBoxItem Tag="15" Content="{DynamicResource Smooth}"/></ComboBox></Grid></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    </TabControl></Grid>
  </Grid>
</Window>
