<Window x:Class="EgressView.Agent.Ui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EgressView.Agent.Ui" Title="EgressView Agent for Windows" Height="900" Width="1440" MinHeight="700" MinWidth="{x:Static local:MainWindow.MinimumWindowWidth}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="CompactGridHeaderStyle" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="6,3"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <DataTemplate x:Key="InsightRankingRowTemplate"><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodySecondaryStyle}" Margin="12,0,0,0" Typography.NumeralAlignment="Tabular"/></Grid></DataTemplate>
    <!-- The compact list and expanded atlas share the same country card, as on macOS. -->
    <DataTemplate x:Key="CountryHistoryCardTemplate">
      <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="10" Margin="0,0,6,8" AutomationProperties.Name="{Binding Country}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="26" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="5" Background="{DynamicResource AccentSoftBrush}">
            <TextBlock Text="{Binding Code}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Country}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Grid.Column="1" Text="{Binding CountWithUnit}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </Grid>
            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource CountryFirstAccess}" Style="{StaticResource BodySecondaryStyle}" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="{Binding First}" FontSize="12" Margin="8,0,0,0" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource CountryLastAccess}" Style="{StaticResource BodySecondaryStyle}" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="{Binding Last}" FontSize="12" Margin="8,0,0,0" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource RecentApplication}" Style="{StaticResource BodySecondaryStyle}" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="{Binding RecentApp}" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RecentApp}"/>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{DynamicResource AppBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="42" Height="42" CornerRadius="10" Background="#0B1424" VerticalAlignment="Center" Margin="0,0,14,0"><Viewbox Margin="7"><Canvas Width="32" Height="32"><Rectangle Canvas.Left="4" Canvas.Top="4" Width="5" Height="24" RadiusX="1.5" Fill="#4D94FF"/><Rectangle Canvas.Left="4" Canvas.Top="4" Width="15" Height="5" RadiusX="1.5" Fill="#4D94FF"/><Rectangle Canvas.Left="4" Canvas.Top="13.5" Width="10" Height="5" RadiusX="1.5" Fill="#4D94FF"/><Rectangle Canvas.Left="4" Canvas.Top="23" Width="15" Height="5" RadiusX="1.5" Fill="#4D94FF"/><Ellipse Canvas.Left="23" Canvas.Top="4" Width="6" Height="6" Fill="#24D6A2"/><Ellipse Canvas.Left="24" Canvas.Top="14" Width="4" Height="4" Fill="#4D94FF"/><Ellipse Canvas.Left="24" Canvas.Top="24" Width="4" Height="4" Fill="#4D94FF"/></Canvas></Viewbox></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="EgressView Agent" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{DynamicResource AppSubtitle}" Style="{StaticResource BodySecondaryStyle}"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="MonitoringBadge" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="14" Padding="12,6" Margin="0,0,18,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="MonitoringDot" Width="8" Height="8" Margin="0,0,7,0"/><TextBlock x:Name="MonitoringStatus" Text="{DynamicResource Checking}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border><TextBlock Text="{DynamicResource Period}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/><ComboBox x:Name="PeriodChoice" Width="148" SelectedIndex="3" SelectionChanged="PeriodChoice_SelectionChanged" AutomationProperties.Name="{DynamicResource Period}"><ComboBoxItem Tag="60" Content="{DynamicResource LastHour}"/><ComboBoxItem Tag="360" Content="{DynamicResource Last6Hours}"/><ComboBoxItem Tag="1440" Content="{DynamicResource Last24Hours}"/><ComboBoxItem Tag="10080" Content="{DynamicResource Last7Days}"/><ComboBoxItem Tag="43200" Content="{DynamicResource Last30Days}"/></ComboBox><Button Content="↻" ToolTip="{DynamicResource Refresh}" AutomationProperties.Name="{DynamicResource Refresh}" Click="Refresh_Click" Style="{StaticResource FluentButtonStyle}" FontSize="19" Padding="12,5" Margin="8,0,0,0"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Row="1" Margin="24,12,24,20"><TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
      <TabItem Header="{DynamicResource NetworkStatus}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Measure}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><ListBox x:Name="MetricChoice" Width="210" SelectedIndex="0" SelectionChanged="AnalysisChoice_SelectionChanged" Style="{StaticResource SegmentedSelectorStyle}" AutomationProperties.Name="{DynamicResource Measure}"><ListBoxItem Tag="connections" Content="{DynamicResource Connections}"/><ListBoxItem Tag="bytes" Content="{DynamicResource DataVolume}"/></ListBox></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{DynamicResource DestinationsBy}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><ListBox x:Name="DestinationChoice" Width="190" SelectedIndex="0" SelectionChanged="AnalysisChoice_SelectionChanged" Style="{StaticResource SegmentedSelectorStyle}" AutomationProperties.Name="{DynamicResource DestinationsBy}"><ListBoxItem Tag="name" Content="{DynamicResource Name}"/><ListBoxItem Tag="ip" Content="{DynamicResource IpAddress}"/></ListBox></StackPanel><Button Grid.Column="5" Content="{DynamicResource ExportCsv}" Click="ExportCsv_Click" Style="{StaticResource FluentButtonStyle}"/></Grid>
        <Grid Grid.Row="2"><ScrollViewer x:Name="NetworkDashboard" VerticalScrollBarVisibility="Auto"><Grid MinHeight="650"><Grid.RowDefinitions><RowDefinition Height="1.05*"/><RowDefinition Height="14"/><RowDefinition Height="0.95*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="0.36*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.64*"/></Grid.ColumnDefinitions>
          <Border x:Name="CountryGlobeCard" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource CommunicationDestinations}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource MarkerMetric}" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><ListBox x:Name="GlobeViewChoice" Grid.Row="1" HorizontalAlignment="Right" Margin="0,6,0,0" Width="240" SelectedIndex="0" SelectionChanged="GlobeViewChoice_SelectionChanged" Style="{StaticResource SegmentedSelectorStyle}"><ListBoxItem Tag="globe" Content="{DynamicResource Globe}"/><ListBoxItem Tag="countries" Content="{DynamicResource DestinationCountries}"/></ListBox></Grid>
            <Grid Grid.Row="1" Margin="0,8,0,0"><local:WorldGlobeControl x:Name="Globe" MinHeight="230"/><Grid x:Name="CountryHistoryPanel" Visibility="Collapsed" ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource CountryHistoryLocalHint}" Style="{StaticResource BodySecondaryStyle}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="ExpandCountryAtlasButton" Grid.Column="1" Content="{DynamicResource Expand}" ToolTip="{DynamicResource ExpandCountryAtlas}" AutomationProperties.Name="{DynamicResource ExpandCountryAtlas}" Click="ExpandCountryAtlas_Click" Style="{StaticResource FluentButtonStyle}" Margin="8,0,0,0"/>
              </Grid>
              <Grid Grid.Row="1" ClipToBounds="True" Margin="0,10,0,0">
                <ScrollViewer x:Name="CountryListScroll" MaxHeight="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                  <ItemsControl x:Name="CountryList" ItemTemplate="{StaticResource CountryHistoryCardTemplate}" Margin="0,0,4,0"/>
                </ScrollViewer>
                <TextBlock x:Name="CountryEmptyNote" Text="{DynamicResource NoCountryHistory}" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Grid>
            </Grid></Grid>
            <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="GlobeCaption" Text="{DynamicResource GlobeUnavailable}" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/><StackPanel x:Name="GlobeControls" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="40" Margin="0,8,0,0"><ListBox x:Name="SpinSpeedChoice" Width="210" Height="40" VerticalAlignment="Center" SelectedIndex="1" SelectionChanged="SpinSpeedChoice_SelectionChanged" Style="{StaticResource SegmentedSelectorStyle}" AutomationProperties.Name="{DynamicResource RotationSpeed}"><ListBoxItem Tag="slow" Content="{DynamicResource Slow}"/><ListBoxItem Tag="normal" Content="{DynamicResource Normal}"/><ListBoxItem Tag="fast" Content="{DynamicResource Fast}"/></ListBox><Button x:Name="RotateButton" Content="{DynamicResource Rotate}" Click="Rotate_Click" Style="{StaticResource FluentButtonStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Grid>
          </Grid></Border>
          <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource PeriodGlance}" FontSize="16" FontWeight="SemiBold"/><Grid Margin="0,9,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Fill, ElementName=MonitoringDot}" Margin="0,0,7,0"/><TextBlock Text="{Binding Text, ElementName=MonitoringStatus}" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="StorageSummary" Style="{StaticResource BodySecondaryStyle}" Margin="0,5,0,0"/><TextBlock x:Name="NetworkLastUpdated" Style="{StaticResource BodySecondaryStyle}" FontSize="12" Margin="0,4,0,0" AutomationProperties.LiveSetting="Off"/></StackPanel><TextBlock x:Name="MonitoringSince" Grid.Column="1" Style="{StaticResource BodySecondaryStyle}" VerticalAlignment="Center"/></Grid><UniformGrid Columns="5"><Border Style="{StaticResource MetricCardStyle}" Margin="0,0,5,0"><StackPanel><TextBlock Text="{DynamicResource Connections}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ConnectionCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource Applications}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ApplicationCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource Destinations}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="DestinationCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource Coverage}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="CoverageValue" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0,0,0"><StackPanel><TextBlock Text="{DynamicResource Threats}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ThreatCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border></UniformGrid><UniformGrid Rows="1" Columns="3" Margin="0,10,0,0"><Border Style="{StaticResource MetricCardStyle}" Margin="0,0,5,0"><StackPanel><TextBlock Text="{DynamicResource SentVolume}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="SentVolumeValue" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource ReceivedVolume}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="ReceivedVolumeValue" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="5,0,0,0"><StackPanel><TextBlock Text="{DynamicResource OutboundAnomalies}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="OutboundAnomalyCount" Text="—" Style="{StaticResource MetricValueStyle}"/></StackPanel></Border></UniformGrid><TextBlock x:Name="CoverageNote" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{DynamicResource PacketPrivacy}" Style="{StaticResource BodySecondaryStyle}" Margin="0,8,0,0"/></StackPanel></Border>
          <Grid Grid.Row="2" Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource WhichAppWhere}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="FlowCaption" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><ScrollViewer x:Name="FlowDiagramScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True" AutomationProperties.Name="{DynamicResource WhichAppWhere}"><local:NetworkFlowControl x:Name="FlowDiagram" Height="380"/></ScrollViewer></Grid></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource WhenTraffic}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="TimelineCaption" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><local:TrafficTimelineControl x:Name="Timeline" Grid.Row="1" Margin="0,12,0,0" MinHeight="150"/><StackPanel x:Name="SleepLegend" Grid.Row="2" Orientation="Horizontal" Visibility="Collapsed" Margin="0,8,0,0"><Border Width="18" Height="10" Background="#380078D4" BorderBrush="#990078D4" BorderThickness="1" CornerRadius="2" Margin="0,2,7,0"/><TextBlock Text="{DynamicResource SleepLegend}" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/></StackPanel></Grid></Border></Grid>
        </Grid></ScrollViewer>
          <Grid x:Name="ExpandedCountryAtlas" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource DestinationCountries}" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="ExpandedCountryCount" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><Button Grid.Column="1" Content="{DynamicResource ReturnToDashboard}" Click="CollapseCountryAtlas_Click" Style="{StaticResource FluentButtonStyle}"/></Grid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><local:WorldCountryMapControl x:Name="CountryMap" AutomationProperties.Name="{DynamicResource DestinationCountries}"/></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="ExpandedCountryList" ItemTemplate="{StaticResource CountryHistoryCardTemplate}" Margin="0,0,4,0"/></ScrollViewer>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid></TabItem>
      <TabItem Header="{DynamicResource Insights}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{DynamicResource LocalInsights}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource InsightsPrivacy}" Style="{StaticResource BodySecondaryStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Text, ElementName=MonitoringStatus}" Style="{StaticResource BodySecondaryStyle}" Margin="0,5,0,0"/></StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="14" Padding="12,6" Margin="16,0,0,0" VerticalAlignment="Top"><TextBlock x:Name="AiProviderStatus" Text="{DynamicResource AiOffNotSent}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="320"/></Border>
        </Grid>
        <UniformGrid Columns="4"><Border Style="{StaticResource MetricCardStyle}" Margin="0,0,6,0" Padding="14"><StackPanel><TextBlock Text="{DynamicResource Connections}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="InsightConnections" Text="—" Style="{StaticResource MetricValueStyle}"/><TextBlock x:Name="InsightConnectionsDelta" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="6,0" Padding="14"><StackPanel><TextBlock Text="{DynamicResource Applications}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="InsightApplications" Text="—" Style="{StaticResource MetricValueStyle}"/><TextBlock x:Name="InsightApplicationsDelta" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="6,0" Padding="14"><StackPanel><TextBlock Text="{DynamicResource Destinations}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="InsightDestinations" Text="—" Style="{StaticResource MetricValueStyle}"/><TextBlock x:Name="InsightDestinationsDelta" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource MetricCardStyle}" Margin="6,0,0,0" Padding="14"><StackPanel><TextBlock Text="{DynamicResource MeasuredData}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="InsightBytes" Text="—" Style="{StaticResource MetricValueStyle}"/><TextBlock x:Name="InsightUnmeasured" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,14,0,0"><StackPanel><TextBlock Text="{DynamicResource WhatChanged}" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="InsightChangeSummary" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock x:Name="InsightTopApp" Style="{StaticResource BodySecondaryStyle}" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock x:Name="InsightTopDestination" Style="{StaticResource BodySecondaryStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource InsightsCountsCaveat}" Style="{StaticResource BodySecondaryStyle}" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,14,0,0"><Expander Header="{DynamicResource AiContextPreview}" AutomationProperties.Name="{DynamicResource AiContextPreview}"><StackPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource AiPreviewExplanation}" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource TopApplications}" FontWeight="SemiBold"/><ItemsControl x:Name="TopApplicationsList" ItemTemplate="{StaticResource InsightRankingRowTemplate}" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource TopDestinations}" FontWeight="SemiBold"/><ItemsControl x:Name="TopDestinationsList" ItemTemplate="{StaticResource InsightRankingRowTemplate}" Margin="0,8,0,0"/></StackPanel></Grid><TextBlock Text="{DynamicResource AiPreviewExcluded}" Style="{StaticResource BodySecondaryStyle}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/><Expander Header="{DynamicResource AiContextJsonPreview}" Margin="0,10,0,0"><TextBox x:Name="AiPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="260" FontFamily="Consolas"/></Expander></StackPanel></Expander></Border>
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,14,0,0"><StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource AskAboutPeriod}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource AiConversationHint}" Style="{StaticResource BodySecondaryStyle}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="AiConversationChoice" Width="210" SelectionChanged="AiConversationChoice_SelectionChanged"/><Button Content="{DynamicResource NewConversation}" Click="NewConversation_Click" Margin="8,0,0,0"/><Button Content="{DynamicResource DeleteConversation}" Click="DeleteConversation_Click" Margin="8,0,0,0"/><Button Content="{DynamicResource DeleteAllConversations}" Click="DeleteAllConversations_Click" Margin="8,0,0,0"/></StackPanel></Grid>
          <TextBox x:Name="AiQuestion" MaxLength="2000" AcceptsReturn="True" MinHeight="64" Margin="0,12,0,0" ToolTip="{DynamicResource AiQuestion}" TextChanged="AiQuestion_TextChanged"/>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AiStatus" Style="{StaticResource BodySecondaryStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource Copy}" Click="CopyAi_Click"/><Button x:Name="StopAiButton" Content="{DynamicResource Stop}" Click="StopAi_Click" IsEnabled="False" Margin="8,0,0,0"/><Button x:Name="AskAiButton" Content="{DynamicResource AnalyzeAsk}" Click="AskAi_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid>
          <TextBlock x:Name="AiConversationEmptyNote" Text="{DynamicResource NoAiMessages}" Style="{StaticResource BodySecondaryStyle}" Margin="0,14,0,0" TextWrapping="Wrap"/>
          <ListBox x:Name="AiConversation" MaxHeight="300" Margin="0,14,0,0" Background="Transparent" BorderThickness="0" Visibility="Collapsed"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Header}" FontWeight="SemiBold"/><TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding Usage}" Style="{StaticResource BodySecondaryStyle}" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource ConnectionLog}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource ConnectionLog}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource LogLimitHint}" Style="{StaticResource BodySecondaryStyle}" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="LogGrain" Width="130" SelectedIndex="0" SelectionChanged="LogGrain_SelectionChanged" Margin="0,0,8,0"><ComboBoxItem Tag="flows" Content="{DynamicResource LogGrainFlows}"/><ComboBoxItem Tag="observations" Content="{DynamicResource LogGrainObservations}"/></ComboBox><ComboBox x:Name="RowLimit" Width="88" SelectedIndex="3" SelectionChanged="RowLimit_SelectionChanged"><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/><ComboBoxItem Content="200"/><ComboBoxItem Content="500"/></ComboBox><Button x:Name="PauseLogButton" Content="{DynamicResource PauseUpdates}" Click="PauseLog_Click" Style="{StaticResource FluentButtonStyle}" Margin="8,0,0,0"/><Button Content="{DynamicResource ExportCsv}" Click="ExportCsv_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid>
