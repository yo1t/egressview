      <TabItem Header="{DynamicResource ConnectionLog}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource ConnectionLog}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource NewestFirstLocal}" Style="{StaticResource BodySecondaryStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="LogSearch" Width="180" ToolTip="{DynamicResource Search}" TextChanged="LogFilter_Changed"/><ComboBox x:Name="ProtocolFilter" Width="110" SelectedIndex="0" SelectionChanged="LogFilter_Changed" Margin="8,0,0,0"><ComboBoxItem Tag="all" Content="{DynamicResource All}"/><ComboBoxItem Tag="TCP" Content="TCP"/><ComboBoxItem Tag="UDP" Content="UDP"/></ComboBox><ComboBox x:Name="RowLimit" Width="88" SelectedIndex="3" SelectionChanged="RowLimit_SelectionChanged" Margin="8,0,0,0"><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/><ComboBoxItem Content="200"/><ComboBoxItem Content="500"/></ComboBox><Button Content="{DynamicResource ExportCsv}" Click="ExportCsv_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid><Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0"><DataGrid x:Name="ConnectionGrid" ItemsSource="{Binding RecentFlows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource SurfaceSecondaryBrush}" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource LastSeen}" Binding="{Binding LastSeenText}" Width="160"/><DataGridTextColumn Header="{DynamicResource Process}" Binding="{Binding ProcessName}" Width="*"/><DataGridTextC