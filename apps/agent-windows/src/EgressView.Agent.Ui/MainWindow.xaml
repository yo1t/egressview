          <StackPanel x:Name="HubSettingsSection" Visibility="Collapsed"><TextBlock Text="{DynamicResource Hub}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource HubSettingsHint}" Style="{StaticResource BodySecondaryStyle}" Margin="0,5,0,20"/><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource HubConnect}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource HubExplanation}" Margin="0,6,0,16" Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hub URL" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="HubUrl" Text="https://"/><TextBlock Text="{DynamicResource EnrollmentCode}" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><PasswordBox x:Name="EnrollmentCode" MaxLength="6"/><Button x:Name="EnrollButton" Content="{DynamicResource RequestEnrollment}" Click="Enroll_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource HubRegistration}" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="DeliveryEnabled" Content="{DynamicResource DeliveryOption}" Click="DeliveryEnabled_Click"/><Border Margin="0,16,0,0" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="14"><TextBlock x:Name="EnrollmentStatus" Text="{DynamicResource NotEnrolled}" TextWrapping="Wrap"/></Border></StackPanel></Grid><Separator Margin="0,22"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource HubDelivery}" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="HubDeliveryTarget" Style="{StaticResource BodySecondaryStyle}" Margin="0,5,0,0"/></StackPanel><Button x:Name="SendNowButton" Grid.Column