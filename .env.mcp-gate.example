# P2-60 PR 5 pre-publication gate.
# Copy to .env.mcp-gate (gitignored), chmod 600, and source it manually.
# The gate never changes DNS, security groups, or application configuration.

MCP_GATE_ENDPOINT=https://mcp.example.com/mcp
MCP_GATE_RESOURCE=https://mcp.example.com/mcp
MCP_GATE_ISSUER=https://auth.example.com/realms/egressview
# Must match the runtime profile. Use cognito only with an AWS Cognito regional
# user-pool issuer and a completed cognitoCompatibility evidence object.
MCP_GATE_OAUTH_COMPATIBILITY_PROFILE=strict
# Private ALB DNS name or another staged target. The TLS SNI/Host remains the
# canonical MCP_GATE_ENDPOINT hostname.
MCP_GATE_CONNECT_ADDRESS=internal-staged-alb.example.local
MCP_GATE_READ_SCOPE=egressview:read
MCP_GATE_WRITE_SCOPE=egressview:notes.write
MCP_GATE_DEPLOYED_COMMIT=0000000000000000000000000000000000000000

MCP_GATE_EVIDENCE_PATH=.egressview-mcp-publication-evidence.json
MCP_GATE_REPORT_PATH=.egressview-mcp-publication-gate.json
MCP_GATE_AUDIT_DB_PATH=.egressview-mcp-audit.db

# Local EgressView checks prove that router collection remains healthy while
# the public MCP boundary is exercised.
MCP_GATE_EGRESSVIEW_URL=http://127.0.0.1:3002
MCP_GATE_EGRESSVIEW_TOKEN=

# Short-lived test credentials. Never put these values in the evidence JSON,
# report, command line, shell history, Git, or CI variables.
MCP_GATE_READ_TOKEN=
MCP_GATE_WRITE_TOKEN=
MCP_GATE_EXPIRED_TOKEN=
MCP_GATE_WRONG_AUDIENCE_TOKEN=
# Revoke its refresh family first, retain this access token only in memory or a
# mode-0600 local env file, and run the gate after its short access TTL expires.
MCP_GATE_REVOKED_EXPIRED_TOKEN=

# The default assumes the Node global limit is 60/minute. Run only in the
# DNS-unpublished staging window because this intentionally fills one bucket.
MCP_GATE_RATE_PROBE_REQUESTS=70
MCP_GATE_ROUTER_MAX_AGE_MS=300000
MCP_GATE_TIMEOUT_MS=10000
